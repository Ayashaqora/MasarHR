# Every VITE_* value is bundled into the browser build and is PUBLIC.
# Never put secrets, tokens or credentials in this file.

# Base URL of the backend REST API. Keep it relative in dev so the Vite proxy is used.
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api (read by vite.config.ts only; not bundled).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Default UI locale: ar (RTL, default) or en (LTR).
VITE_DEFAULT_LOCALE=ar
